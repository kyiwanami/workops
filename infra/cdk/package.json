    "eslint": "^10.5.0",
    "jest": "^30",
    "prettier": "^3.8.4",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1070.0",
    "aws-cdk-lib": "^2.238.0",
    "constructs": "^10.0.0"
  }
