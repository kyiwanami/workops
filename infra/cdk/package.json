{
  "name": "cdk",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk:deploy-app": "cdk --app \"npx ts-node --prefer-ts-exts bin/cdk-deploy.ts\"",
    "cdk:infra": "cdk --app \"npx ts-node --prefer-ts-exts bin/cdk-infra.ts\"",
    "cdk:runtime": "cdk --app \"npx ts-node --prefer-ts-exts bin/cdk-runtime.ts\""
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1126.0",
    "esbuild": "^0.28.1",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1070.0",
    "aws-cdk-lib": "^2.238.0",
    "constructs": "^10.0.0"
  }
}
